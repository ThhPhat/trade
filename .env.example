# --- CẤU HÌNH KẾT NỐI CSDL MICROSOFT SQL SERVER (Mặc định) ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=QL_NhaSach;encrypt=true;trustServerCertificate=true;
DB_USERNAME=the4book_user
DB_PASSWORD=ChangeMe@2026
DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver
DB_DIALECT=org.hibernate.dialect.SQLServerDialect

# Nếu bạn dùng tài khoản sa:
# DB_USERNAME=sa
# DB_PASSWORD=mat_khau_sa_cua_ban

# Nếu bạn dùng Windows Authentication:
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=QL_NhaSach;integratedSecurity=true;encrypt=true;trustServerCertificate=true;
# DB_USERNAME=
# DB_PASSWORD=

# =========================================================================
# CẤU HÌNH DỊCH VỤ NGOÀI (PLACEHOLDERS)
# =========================================================================
# Google OAuth2 Login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gửi mail qua Gmail SMTP
MAIL_USERNAME=nhasachthe4bookstore@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Lưu trữ hình ảnh đám mây Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# JWT Secret Key
JWT_SECRET=the4BookStore_SuperSecret_Jwt_Signing_Key_2026_DBMS330284_HCMUTE_Key
